# =====================================
# WHATSAPP AUTOMATION DEMO - CONFIGURATION
# =====================================
# Copy this file to .env and configure per environment.

# ─── ENTORNO ──────────────────────────
NODE_ENV=production
# Human dashboard port for the demo.
DASHBOARD_HUMANO_PORT=5011

# ─── CORS PARA WEBSOCKET ─────────────
# In shared environments, set this to the deployed dashboard origin.
CORS_ORIGIN=*

# ─── INTERVALOS DE ACTUALIZACIÓN ─────
# Tiempo entre actualizaciones WebSocket en ms (default: 10000 = 10s)
WS_UPDATE_INTERVAL=10000

# ─── AGENTES (PUERTOS) ──────────────
# Agent config source.
AGENTS_CONFIG_PATH=multi-tenant/clients/internal-demo/agents.json
ORCHESTRATOR_START_DASHBOARDS=false

# ─── WHATSAPP ─────────────────────────
# Ruta base para sesiones de WhatsApp (default: ./.wwebjs_auth)
WHATSAPP_AUTH_PATH=./.wwebjs_auth
# Versión de WhatsApp Web (no cambiar si funciona)
WHATSAPP_VERSION=2.2412.54

# ─── API KEYS (LLM) ──────────────────
# Proveedor LLM: gemini u openrouter
LLM_PROVIDER=openrouter

# Gemini API Key (https://ai.google.dev/)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter API Key (principal si LLM_PROVIDER=openrouter, fallback si provider=gemini)
OPENROUTER_API_KEY=tu_api_key_de_openrouter_aqui
OPENROUTER_MODEL=openrouter/owl-alpha
OPENROUTER_SITE_URL=http://localhost:5011
OPENROUTER_APP_NAME=WhatsApp Automation Demo
LLM_ENABLE_GEMINI_FALLBACK=false
LLM_TEMPERATURE=0.4

# Transcripción de audios WhatsApp (opcional, local CPU-only)
# Si está deshabilitado o falta el comando local, el bot pide texto.
ENABLE_AUDIO_TRANSCRIPTION=false
AUDIO_TRANSCRIPTION_PROVIDER=local
AUDIO_TRANSCRIPTION_COMMAND=python3 scripts/transcribe-audio-local.py
AUDIO_TRANSCRIPTION_MAX_BYTES=8388608
AUDIO_TRANSCRIPTION_TIMEOUT_MS=45000
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

# ─── RUTAS DE ARCHIVOS ───────────────
# Rutas relativas (no cambiar a menos que sea necesario)
DATA_PATH=./data
LOGS_PATH=./logs
CATALOGS_PATH=./catalogs

# ─── CONFIGURACIÓN DE REDIS (OPCIONAL) ─
# Para escalar a múltiples instancias en VPS
# REDIS_URL=redis://localhost:6379

# ─── LOGGING ──────────────────────────
# Nivel de logging: debug, info, warn, error (default: info)
LOG_LEVEL=info

# ─── TIEMPOS DE REINTENTO ────────────
# Tiempo entre reintentos de LLM en ms (default: 3000)
LLM_RETRY_DELAY=3000
# Número máximo de reintentos (default: 3)
LLM_MAX_RETRIES=3

# ─── SEGURIDAD ───────────────────────
# Tiempo de auto-resume para usuarios pausados en ms (default: 1800000 = 30 min)
AUTO_RESUME_TIMEOUT_MS=1800000

# =====================================
# DEPLOYMENT NOTES
# =====================================
# 1. Install Node.js 18+.
# 2. Clone the repository.
# 3. Copy .env.example to .env.
# 4. Set real API keys in .env.
# 5. Install dependencies with npm install.
# 6. Start the demo PM2 ecosystem from multi-tenant/clients/internal-demo.
