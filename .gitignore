.agents/
repos/
convex/
skills-lock.json

# Build outputs
dist/
build/
*.pyc
__pycache__/
.venv*/

# Environment
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
.cache/

# Memory system indexes (generated, not source)
.gsd/memory/.index/*.db
.gsd/memory/.index/*.json
.gsd/archive/**/memory/.index/*.db
.gsd/archive/**/memory/.index/*.json
